---
import SiteLayout from "../layouts/SiteLayout.astro";
import { siteConfig } from "../data/config";
import { evidenceNotice } from "../data/reported-guides";
---

<SiteLayout title={`Guide | ${siteConfig.siteName}`} description={`Evidence-first guide hub for ${siteConfig.gameName}.`}>
  <main class="content-page">
    <section class="prose-block">
      <p class="eyebrow">Guide</p>
      <h1>{siteConfig.gameName} Guide</h1>
      <p>{evidenceNotice.body}</p>
      <p>Use this page as the main route map for beginner steps, core systems, and verified gameplay notes. Keep unverified tactics marked as community-reported or pending.</p>
    </section>
    <section class="section">
      <h2>Guide sections</h2>
      <div class="card-grid">
        <article class="card">
          <h3>First session path</h3>
          <p>Draft the first-session route only after checking the live Roblox game or official sources.</p>
        </article>
        <article class="card">
          <h3>Core loop</h3>
          <p>Describe the gameplay loop with source labels. Do not invent mechanics or rewards.</p>
        </article>
      </div>
    </section>
  </main>
</SiteLayout>
