---
import SiteLayout from "../layouts/SiteLayout.astro";
import { siteConfig } from "../data/config";
---

<SiteLayout title={`Privacy Policy | ${siteConfig.siteName}`} description={`Privacy policy for ${siteConfig.siteName}.`} noindex>
  <main class="content-page">
    <section class="prose-block">
      <p class="eyebrow">System page</p>
      <h1>Privacy Policy</h1>
      <p>{siteConfig.siteName} is an independent fan guide template. This page explains the basic privacy boundaries used by new sites created from this template.</p>
      <h2>Information boundaries</h2>
      <p>This template does not require private Roblox account information or sensitive account recovery details.</p>
      <h2>Third-party services</h2>
      <p>A deployed site may use analytics, advertising, or hosting services. Review all configured scripts before launch.</p>
      <h2>Contact</h2>
      <p>For privacy questions, contact <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>.</p>
    </section>
  </main>
</SiteLayout>
